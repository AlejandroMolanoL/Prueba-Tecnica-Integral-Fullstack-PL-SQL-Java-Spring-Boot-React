{
  "info": {
    "_postman_id": "b3e94a82-f87c-482d-8f24-9dfc8c11aa50",
    "name": "OL Software - Backend Comerciantes API",
    "description": "Colección completa de endpoints para la prueba técnica Spring Boot Fullstack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAuxiliar",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Seguridad & Autenticación",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.exito && jsonData.datos && jsonData.datos.token) {",
                  "    pm.collectionVariables.set('tokenAdmin', jsonData.datos.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correoElectronico\": \"admin@olsoftware.com\",\n  \"contrasena\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Auxiliar de Registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.exito && jsonData.datos && jsonData.datos.token) {",
                  "    pm.collectionVariables.set('tokenAuxiliar', jsonData.datos.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correoElectronico\": \"auxiliar@olsoftware.com\",\n  \"contrasena\": \"Auxiliar123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Listas de Valores (Caché)",
      "item": [
        {
          "name": "Obtener Departamentos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/departamentos",
              "host": ["{{baseUrl}}"],
              "path": ["departamentos"]
            }
          }
        },
        {
          "name": "Obtener Municipios por ID Departamento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/departamentos/1/municipios",
              "host": ["{{baseUrl}}"],
              "path": ["departamentos", "1", "municipios"]
            }
          }
        },
        {
          "name": "Obtener Municipios por Nombre Departamento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/municipios?departamento=Antioquia",
              "host": ["{{baseUrl}}"],
              "path": ["municipios"],
              "query": [
                {
                  "key": "departamento",
                  "value": "Antioquia"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. CRUD Comerciantes",
      "item": [
        {
          "name": "Consulta Paginada con Filtros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comerciantes?pagina=1&registrosPorPagina=5",
              "host": ["{{baseUrl}}"],
              "path": ["comerciantes"],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "registrosPorPagina",
                  "value": "5"
                },
                {
                  "key": "nombre",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "municipio",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "estado",
                  "value": "Activo",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Consultar Comerciante por ID",
