            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreRazonSocial\": \"Comercializadora Nueva Era S.A.S.\",\n  \"departamento\": \"Antioquia\",\n  \"municipio\": \"Medellín\",\n  \"telefono\": \"+57 311 234 5678\",\n  \"correoElectronico\": \"contacto@nuevaera.com\",\n  \"fechaRegistro\": \"2024-05-10\",\n  \"estado\": \"Activo\",\n  \"establecimientos\": [\n    {\n      \"nombreEstablecimiento\": \"Sede Centro Nueva Era\",\n      \"ingresos\": 35000000.50,\n      \"numeroEmpleados\": 8\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comerciantes",
              "host": ["{{baseUrl}}"],
              "path": ["comerciantes"]
            }
          }
        },
        {
          "name": "Actualizar Comerciante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
