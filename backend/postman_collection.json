                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreRazonSocial\": \"Comercializadora Nueva Era Renovada S.A.S.\",\n  \"departamento\": \"Antioquia\",\n  \"municipio\": \"Medellín\",\n  \"telefono\": \"+57 311 999 8877\",\n  \"correoElectronico\": \"gerencia@nuevaera.com\",\n  \"fechaRegistro\": \"2024-05-10\",\n  \"estado\": \"Activo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comerciantes/1",
              "host": ["{{baseUrl}}"],
              "path": ["comerciantes", "1"]
            }
          }
        },
        {
          "name": "Modificar Estado Comerciante (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"Inactivo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comerciantes/1/estado",
              "host": ["{{baseUrl}}"],
              "path": ["comerciantes", "1", "estado"]
            }
          }
        },
        {
          "name": "Eliminar Comerciante (Solo Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comerciantes/10",
              "host": ["{{baseUrl}}"],
              "path": ["comerciantes", "10"]
            }
          }
        }
      ]
    },
